# Built zips
dist/

# Safety copies the app makes before every save, and the half-written file a save is in the middle of
*.backup.json
*.saving
apps/ads/data/*.tmp-*

# A customer's own skill and its zip: never ships
skills-to-upload/*.zip

# The claude-ads skills and agents, installed during setup from George's fork (see
# setup/scripts/install-claude-ads.sh). They are never committed or shipped.
.claude/skills/ads/
.claude/skills/ads-*/
.claude/skills/.claude-ads-*.manifest
.claude/agents/

# claude-ads' own setup profile and runs, kept in this folder while someone uses it
.claude-ads/

# Computer clutter
.DS_Store
._*
Thumbs.db
desktop.ini

# Local Claude Code files that belong to one computer, not the kit
.claude/launch.json
.claude/settings.local.json
.claude/.cc-writes/

# Home layout: one person's choice of boxes, made while testing
apps/home/data/
__pycache__/
*.pyc

# The saved download of each tool as a customer installed it: theirs, not the kit's
setup/as-installed/*
!setup/as-installed/README.md

# Photos and videos added to ads: they stay on this computer, never in the kit
apps/*/data/media/
